{
  "manifest_version": 3,
  "name": "SyncBoard Bridge",
  "version": "1.0",
  "description": "Enables perfect movie and media synchronization in SyncBoard collaborative rooms.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@syncboard.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
